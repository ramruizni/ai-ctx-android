package com.ramruizni.deepseekpokeappfour.pokemon.datasource

import com.ramruizni.deepseekpokeappfour.pokemon.domain.Pokemon
import com.ramruizni.deepseekpokeappfour.pokemon.domain.PokemonStats
import kotlinx.serialization.encodeToString
import kotlinx.serialization.decodeFromString
import kotlinx.serialization.json.Json

/**
 * Extension function to convert Pokemon domain model to PokemonDbDto
 */
fun Pokemon.toDbDto(): PokemonDbDto {
    return PokemonDbDto(
        id = this.id,
        name = this.name,
        number = this.number,
        imageUrl = this.imageUrl,
        types = Json.encodeToString(this.types),
        abilities = Json.encodeToString(this.abilities),
        statsHp = this.stats.hp,
        statsAttack = this.stats.attack,
        statsDefense = this.stats.defense,
        statsSpecialAttack = this.stats.specialAttack,
        statsSpecialDefense = this.stats.specialDefense,
        statsSpeed = this.stats.speed
    )
}

/**
 * Extension function to convert PokemonDbDto to Pokemon domain model
 */
fun PokemonDbDto.toDomain(): Pokemon {
    return Pokemon(
        id = this.id,
        name = this.name,
        number = this.number,
        imageUrl = this.imageUrl,
        types = Json.decodeFromString<List<String>>(this.types),
        abilities = Json.decodeFromString<List<String>>(this.abilities),
        stats = PokemonStats(
            hp = this.statsHp,
            attack = this.statsAttack,
            defense = this.statsDefense,
            specialAttack = this.statsSpecialAttack,
            specialDefense = this.statsSpecialDefense,
            speed = this.statsSpeed
        )
    )
}

/**
 * Extension function to convert list of Pokemon domain models to list of PokemonDbDto
 */
fun List<Pokemon>.toDbDto(): List<PokemonDbDto> = map { it.toDbDto() }

/**
 * Extension function to convert list of PokemonDbDto to list of Pokemon domain models
 */
fun List<PokemonDbDto>.toDomain(): List<Pokemon> = map { it.toDomain() }